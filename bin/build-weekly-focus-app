#!/usr/bin/env bash
#
# Build the native Weekly Focus macOS app bundle.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
PACKAGE_DIR="$ROOT_DIR/packages/focus-app"
APP_DIR="$PACKAGE_DIR/.build/Weekly Focus.app"
INSTALL_DIR="${WEEKLY_FOCUS_INSTALL_DIR:-$HOME/Applications}"
INSTALLED_APP_DIR="$INSTALL_DIR/Weekly Focus.app"
EXECUTABLE_SRC="$PACKAGE_DIR/.build/release/weekly-focus-app"
EXECUTABLE_DEST="$APP_DIR/Contents/MacOS/Weekly Focus"
ICON_SRC="$PACKAGE_DIR/Resources/WeeklyFocus.icns"
ICON_DEST="$APP_DIR/Contents/Resources/WeeklyFocus.icns"

swift build --package-path "$PACKAGE_DIR" -c release >&2

rm -rf "$APP_DIR"
mkdir -p "$APP_DIR/Contents/MacOS" "$APP_DIR/Contents/Resources"
cp "$EXECUTABLE_SRC" "$EXECUTABLE_DEST"
cp "$ICON_SRC" "$ICON_DEST"

cat >"$APP_DIR/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>Weekly Focus</string>
  <key>CFBundleIconFile</key>
  <string>WeeklyFocus.icns</string>
  <key>CFBundleIdentifier</key>
  <string>com.jonmagic.weekly-focus</string>
  <key>CFBundleName</key>
  <string>Weekly Focus</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NSSupportsAutomaticGraphicsSwitching</key>
  <true/>
</dict>
</plist>
PLIST

# The app reads a GitHub token from the login keychain. macOS ties a keychain ACL
# to the caller's code signature, so an ad-hoc signature -- whose hash changes on
# every build -- makes macOS re-prompt for the keychain password after each rebuild.
# Signing with a real identity yields a stable designated requirement, so "Always
# Allow" survives rebuilds. Fall back to ad-hoc when no identity is available.
SIGN_IDENTITY="${WEEKLY_FOCUS_SIGN_IDENTITY:-}"
if [[ -z "$SIGN_IDENTITY" ]]; then
  SIGN_IDENTITY="$(
    security find-identity -v -p codesigning 2>/dev/null |
      sed -n 's/.*"\(Developer ID Application: .*\)"/\1/p' |
      head -1
  )"
fi
if [[ -z "$SIGN_IDENTITY" ]]; then
  SIGN_IDENTITY="-"
fi

codesign --force --sign "$SIGN_IDENTITY" \
  --identifier com.jonmagic.weekly-focus \
  "$APP_DIR" >&2

mkdir -p "$INSTALL_DIR"
rm -rf "$INSTALLED_APP_DIR"
cp -R "$APP_DIR" "$INSTALLED_APP_DIR"

echo "$INSTALLED_APP_DIR"
