#!/usr/bin/env bun
/**
 * weekly-focus-card: Print a sparse focus card capped at five board tasks.
 *
 * Usage:
 *   weekly-focus-card
 */

import { parseArgs } from "node:util"
import { formatWeeklyFocusCard, runWeeklyFocus } from "../src/weekly-note-commitments.js"

const { values } = parseArgs({
  options: {
    "brain-tasks-path": { type: "string" },
    help: { type: "boolean", short: "h" },
  },
})

if (values.help) {
  console.log(`
Usage: weekly-focus-card [options]

Options:
  --brain-tasks-path PATH  Override the brain-tasks executable
  -h, --help               Show this help message
`)
  process.exit(0)
}

const focus = await runWeeklyFocus({
  brainTasksPath: values["brain-tasks-path"],
  todoLimit: 5,
})

console.log(formatWeeklyFocusCard(focus))
